{
  "description": "Venue map link -> coordinates (screens.md §3 step 4, §15.3). Rules: spec/test-vectors/README.md#maps. `expected` null = keep the link, no coordinates; `error` = reject the link.",
  "cases": [
    { "input": "https://www.google.com/maps/place/G%C3%BCl%C3%BCstan+Saray%C4%B1/@40.3536,49.8364,17z/data=!3m1!4b1!4m6!3m5!1s0x0:0x0!8m2!3d40.35412!4d49.83651", "expected": { "lat": 40.35412, "lng": 49.83651 }, "note": "!3d/!4d (the place) wins over @ (the map view)" },
    { "input": "https://www.google.com/maps/place/Hall/@40.3536,49.8364,17z", "expected": { "lat": 40.3536, "lng": 49.8364 } },
    { "input": "https://www.google.com/maps/@-33.8688,151.2093,12z", "expected": { "lat": -33.8688, "lng": 151.2093 } },
    { "input": "https://maps.google.com/?q=40.3536,49.8364", "expected": { "lat": 40.3536, "lng": 49.8364 } },
    { "input": "https://www.google.com/maps/search/?api=1&query=40.3536%2C49.8364", "expected": { "lat": 40.3536, "lng": 49.8364 } },
    { "input": "https://www.google.az/maps?ll=40.4093,49.8671&z=15", "expected": { "lat": 40.4093, "lng": 49.8671 } },
    { "input": "https://maps.google.com/maps?q=40.3536, 49.8364&hl=az", "expected": { "lat": 40.3536, "lng": 49.8364 } },
    { "input": "https://waze.com/ul?ll=40.3536,49.8364&navigate=yes", "expected": { "lat": 40.3536, "lng": 49.8364 } },
    { "input": "https://maps.apple.com/?ll=40.3536,49.8364&q=Hall", "expected": { "lat": 40.3536, "lng": 49.8364 } },
    { "input": "  https://maps.google.com/?q=40.3536,49.8364  ", "expected": { "lat": 40.3536, "lng": 49.8364 } },

    { "input": "https://maps.app.goo.gl/AbCdEf123", "expected": null, "note": "short link: valid, but coordinates need a network call — not done" },
    { "input": "https://goo.gl/maps/xyz", "expected": null },
    { "input": "https://www.google.com/maps/place/G%C3%BCl%C3%BCstan+Saray%C4%B1", "expected": null },
    { "input": "https://maps.google.com/?q=G%C3%BClustan+saray%C4%B1", "expected": null, "note": "text search, no numbers" },
    { "input": "https://maps.google.com/?q=95.0,49.8", "expected": null, "note": "latitude out of range" },
    { "input": "https://maps.google.com/?q=40.3,190.0", "expected": null, "note": "longitude out of range" },
    { "input": "https://yandex.az/maps/?ll=49.8364%2C40.3536&z=17", "expected": null, "note": "other providers: link kept, Yandex puts lng first so it is not parsed" },
    { "input": "https://evil.example/?q=40.3536,49.8364", "expected": null, "note": "coordinates only from known map hosts" },
    { "input": "https://www.google.com.evil.example/maps/@40.1,49.1,10z", "expected": null, "note": "host must really be Google" },

    { "input": "javascript:alert(1)", "expected": null, "error": "invalid_url" },
    { "input": "maps.google.com/?q=40.3536,49.8364", "expected": null, "error": "invalid_url", "note": "scheme required" },
    { "input": "ftp://maps.google.com/?q=1,2", "expected": null, "error": "invalid_url" },
    { "input": "", "expected": null, "error": "empty" }
  ]
}
