{
  "description": "Phone normalisation to E.164. Rules: spec/test-vectors/README.md#phones. Every platform must return exactly `expected` (or `error` when expected is null).",
  "az_mobile_prefixes": ["10", "50", "51", "55", "60", "70", "77", "99"],
  "cases": [
    { "input": "050 123 45 67", "expected": "+994501234567" },
    { "input": "+994501234567", "expected": "+994501234567" },
    { "input": "994 50 123-45-67", "expected": "+994501234567" },
    { "input": "0501234567", "expected": "+994501234567" },
    { "input": "(050) 123-45-67", "expected": "+994501234567" },
    { "input": "+994 (50) 123 45 67", "expected": "+994501234567" },
    { "input": "00994501234567", "expected": "+994501234567" },
    { "input": "994501234567", "expected": "+994501234567" },
    { "input": "501234567", "expected": "+994501234567" },
    { "input": "050.123.45.67", "expected": "+994501234567" },
    { "input": "0 50 123 45 67", "expected": "+994501234567" },
    { "input": "  055 222 33 44  ", "expected": "+994552223344" },
    { "input": "+994 55 222 33 44", "expected": "+994552223344" },
    { "input": "070-333-44-55", "expected": "+994703334455" },
    { "input": "077 444 55 66", "expected": "+994774445566" },
    { "input": "099 555 66 77", "expected": "+994995556677" },
    { "input": "010 123 45 67", "expected": "+994101234567" },
    { "input": "051 765 43 21", "expected": "+994517654321" },
    { "input": "060 111 22 33", "expected": "+994601112233" },
    { "input": "＋９９４５０１２３４５６７", "expected": "+994501234567", "note": "full-width digits from some keyboards" },

    { "input": "+90 532 123 45 67", "expected": "+905321234567", "note": "foreign: only E.164 length is checked" },
    { "input": "+7 916 123-45-67", "expected": "+79161234567" },
    { "input": "+1 (415) 555-0132", "expected": "+14155550132" },
    { "input": "0090 532 123 45 67", "expected": "+905321234567" },

    { "input": "", "expected": null, "error": "empty" },
    { "input": "   ", "expected": null, "error": "empty" },
    { "input": "12345", "expected": null, "error": "invalid" },
    { "input": "050 123 45 6", "expected": null, "error": "invalid" },
    { "input": "050 123 45 678", "expected": null, "error": "invalid" },
    { "input": "+99450123456", "expected": null, "error": "invalid" },
    { "input": "+9945012345678", "expected": null, "error": "invalid" },
    { "input": "abc", "expected": null, "error": "invalid" },
    { "input": "050-ABC-45-67", "expected": null, "error": "invalid" },
    { "input": "+0501234567", "expected": null, "error": "invalid" },
    { "input": "+12", "expected": null, "error": "invalid" },
    { "input": "+1234567890123456", "expected": null, "error": "invalid", "note": "16 digits > E.164 maximum of 15" },
    { "input": "8 050 123 45 67", "expected": null, "error": "invalid" },
    { "input": "+994 50 123 45 67 ext 2", "expected": null, "error": "invalid" },
    { "input": "012 345 67 89", "expected": null, "error": "not_mobile", "note": "Baku landline" },
    { "input": "+994124567890", "expected": null, "error": "not_mobile" },
    { "input": "040 123 45 67", "expected": null, "error": "not_mobile", "note": "no such mobile operator" },
    { "input": "0221234567", "expected": null, "error": "not_mobile", "note": "regional landline (Ganja)" }
  ]
}
