{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template.schema.json",
  "title": "Guest page template metadata (template.json)",
  "description": "See spec/templates.md §2.",
  "type": "object",
  "required": ["id", "version", "tier", "name", "event_types", "langs", "blocks", "css_vars", "fonts", "texts", "photos", "music"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(free|premium)-[0-9]{2}$" },
    "version": { "type": "integer", "minimum": 1 },
    "tier": { "enum": ["free", "premium"] },
    "name": {
      "type": "object",
      "required": ["az", "ru", "en", "tr"],
      "additionalProperties": false,
      "properties": {
        "az": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "tr": { "type": "string", "minLength": 1 }
      }
    },
    "event_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["wedding", "engagement", "henna", "birthday", "jubilee"] }
    },
    "langs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["az", "ru", "en", "tr"] }
    },
    "blocks": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["hero", "countdown", "gallery", "music", "map", "table", "rsvp", "watermark"] },
      "allOf": [
        { "contains": { "const": "hero" } },
        { "contains": { "const": "rsvp" } }
      ]
    },
    "css_vars": {
      "type": "object",
      "propertyNames": { "pattern": "^--dv-[a-z0-9-]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "default", "label_key"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["color", "font"] },
          "default": { "type": "string", "minLength": 1 },
          "label_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$" }
        },
        "if": { "properties": { "type": { "const": "color" } } },
        "then": { "properties": { "default": { "pattern": "^#[0-9a-fA-F]{6}$" } } }
      }
    },
    "fonts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_-]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["family", "fallback", "file"],
        "additionalProperties": false,
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "fallback": { "enum": ["serif", "sans-serif", "cursive", "monospace"] },
          "file": { "type": "string", "pattern": "^assets/[a-zA-Z0-9_./-]+\\.woff2$" }
        }
      }
    },
    "texts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["max_length", "label_key"],
        "additionalProperties": false,
        "properties": {
          "max_length": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "label_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$" }
        }
      }
    },
    "photos": {
      "type": "object",
      "required": ["max"],
      "additionalProperties": false,
      "properties": { "max": { "type": "integer", "minimum": 0, "maximum": 6 } }
    },
    "music": { "type": "boolean" }
  },
  "if": { "properties": { "tier": { "const": "free" } } },
  "then": { "properties": { "blocks": { "contains": { "const": "watermark" } } } }
}
