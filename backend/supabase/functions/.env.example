# Edge Function secrets (T4C). Locally: copy to backend/supabase/functions/.env (gitignored).
# Production: `supabase secrets set --env-file backend/supabase/functions/.env`. Never commit real values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# Google Play: service account with "View financial data" + "Manage orders" in Play Console.
GOOGLE_PLAY_PACKAGE_NAME=az.devet.app
GOOGLE_SERVICE_ACCOUNT_JSON=
# Accept license-tester purchases (purchaseType 0). true while testing; decide before launch.
GOOGLE_ALLOW_TEST_PURCHASES=false

# App Store Server API: App Store Connect > Users and Access > Integrations > In-App Purchase key (.p8).
APPLE_BUNDLE_ID=az.devet.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Accept sandbox transactions. App Review and TestFlight buy in the sandbox, so production usually needs true.
APPLE_ALLOW_SANDBOX=false

# Shared secret in the Play RTDN push URL: .../functions/v1/store-notifications/google?token=<value>
STORE_NOTIFICATION_TOKEN=
