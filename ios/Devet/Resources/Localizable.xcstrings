    "settings.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahibi olduğunuz tədbirlər bütün qonaqları ilə silinəcək, ortaq olduğunuz tədbirlərdən çıxarılacaqsınız. Bunu geri qaytarmaq olmur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мероприятия, владельцем которых вы являетесь, будут удалены вместе со всеми гостями, а из совместных мероприятий вы будете исключены. Это нельзя отменить."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events you own will be deleted with all their guests, and you will be removed from events you co-host. This cannot be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahibi olduğunuz etkinlikler tüm davetlileriyle silinecek, ortak olduğunuz etkinliklerden çıkarılacaksınız. Bu geri alınamaz."
          }
        }
      }
    },
