    "wa_message.birthday": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hörmətli %1$@! %2$@ ad gününə dəvətlisiniz. Dəvətnamə: %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравствуйте, %1$@! Приглашаем вас на день рождения: %2$@. Приглашение: %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dear %1$@, you are invited to the birthday of %2$@. Invitation: %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayın %1$@, doğum gününe davetlisiniz: %2$@. Davetiye: %3$@"
          }
        }
      }
    },
