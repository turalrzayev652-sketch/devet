            "value": "Qonaq öz dəvətnaməsində masa nömrəsini və eyni masadakı qonaqların adlarını görəcək."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гость увидит в приглашении номер стола и имена гостей за тем же столом."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guests will see their table number and the names of the others at the same table in their invitation."
          }
