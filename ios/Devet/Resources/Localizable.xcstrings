    "excel.body": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk sətir başlıqdır: Ad, Telefon, Hitab, Nəfər, Ailəliklə, Tərəf, Masa. Rus, ingilis və türk başlıqları da tanınır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая строка — заголовки: Имя, Телефон, Обращение, Кол-во, С семьёй, Сторона, Стол. Распознаются и азербайджанские, английские, турецкие заголовки."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first row is the header: Name, Phone, Salutation, Count, With family, Side, Table. Azerbaijani, Russian and Turkish headers work too."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk satır başlıktır: Ad, Telefon, Hitap, Kişi, Ailece, Taraf, Masa. Azerbaycanca, Rusça ve İngilizce başlıklar da tanınır."
          }
        }
      }
    },
