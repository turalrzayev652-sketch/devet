# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-side only: signs event-media URLs in functions/i/[code].js. Never in public/ or git.
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_BASE_URL=http://localhost:8788
# {{BRAND_NAME}} from PRODUCT.md; defaults to Devet
BRAND_NAME=Devet
